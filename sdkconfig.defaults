# Target: classic ESP32 (Freenove Robot Dog / WROVER module)
CONFIG_IDF_TARGET="esp32"

# Flash size (WROVER 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Flash frequency
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# Custom partition table (BLE + WiFi + Camera firmware exceeds default app size)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (WROVER external SPI PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_SPI=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Bluetooth: NimBLE stack (used by the Arduino BLE library NimBLE backend)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# FreeRTOS tick at 1000Hz to match the original Arduino timing (vTaskDelay(20)=20ms)
CONFIG_FREERTOS_HZ=1000

# ADC calibration (line fitting) for battery voltage reading on classic ESP32
CONFIG_ADC_CALI_ENABLE=y

# Keep using the legacy touch_pad_* driver on classic ESP32 without deprecation warnings
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

# Main task stack: setup() initializes BLE + camera + services
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
